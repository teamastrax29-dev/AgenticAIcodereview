APP_ENV=development
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/code_reviewer

GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:8000/api/v1/auth/github/callback

# Generate keys using:
# python -c "import secrets; from cryptography.fernet import Fernet; print(secrets.token_hex(32)); print(Fernet.generate_key().decode())"
JWT_SECRET_KEY=replace_with_64_char_hex
TOKEN_ENCRYPTION_KEY=replace_with_fernet_key
